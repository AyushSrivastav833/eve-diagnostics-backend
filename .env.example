# Copy to .env and adjust. docker-compose reads this file automatically.

DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL (docker-compose service "db"). Leave unset locally to use SQLite.
POSTGRES_DB=eve
POSTGRES_USER=eve
POSTGRES_PASSWORD=eve
DATABASE_URL=postgres://eve:eve@db:5432/eve

# Redis: cache + rate limiting + Celery broker. Leave unset locally to use in-memory cache / eager tasks.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Shared secret between us and the (simulated) payment provider for webhook signatures.
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
BOOKING_MAX_DAYS_AHEAD=60
LOG_LEVEL=INFO

# Demo accounts created by `python manage.py seed_catalog --with-users`
SEED_ADMIN_EMAIL=admin@eve.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_PATIENT_EMAIL=patient@eve.local
SEED_PATIENT_PASSWORD=Patient@12345
